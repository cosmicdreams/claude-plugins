{
    "description": "Blocks twg writes that credit an agent, and git.drupalcode.org posts that skip the worth-it gate.",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/twg-attribution-guard.sh",
                        "timeout": 10
                    },
                    {
                        "type": "command",
                        "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/upstream-post-guard.py\"",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}

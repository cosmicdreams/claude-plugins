{
    "description": "Keeps Claude away from the person's design-lab runner token, and draws the run's pane: where the run is and when it is done.",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_runner_token.ts\"",
                        "timeout": 10
                    }
                ]
            }
        ]
    },
    "modules": [
        "./mod/register.tsx"
    ]
}

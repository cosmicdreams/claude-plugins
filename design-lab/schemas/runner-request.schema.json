{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/runner-request.schema.json",
  "title": "RunnerRequest",
  "description": "Query-string values for /next, /record, /error and /file. Token is transient and must never be stored in run artifacts.",
  "type": "object",
  "properties": {
    "fileKey": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "step": {
      "type": "string"
    },
    "i": {
      "type": "string"
    }
  },
  "required": [
    "fileKey",
    "token",
    "version"
  ],
  "additionalProperties": true
}

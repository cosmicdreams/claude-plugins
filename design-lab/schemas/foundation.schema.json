{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/foundation.schema.json",
  "title": "design-lab Figma foundation receipt",
  "type": "object",
  "required": [
    "standardVersion",
    "toolVersion",
    "figmaFileKey",
    "pages",
    "collections",
    "validation"
  ],
  "properties": {
    "standardVersion": {
      "type": "string"
    },
    "toolVersion": {
      "type": "string"
    },
    "figmaFileKey": {
      "type": "string",
      "minLength": 1
    },
    "pages": {
      "type": "object",
      "minProperties": 1,
      "properties": {},
      "additionalProperties": {
        "type": "string"
      }
    },
    "collections": {
      "type": "object",
      "minProperties": 1,
      "properties": {},
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "modes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "variables": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "errors"
      ],
      "properties": {
        "errors": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

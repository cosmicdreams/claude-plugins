{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/components.schema.json",
  "title": "design-lab component inventory",
  "type": "object",
  "required": [
    "standardVersion",
    "toolVersion",
    "generatedAt",
    "source",
    "components"
  ],
  "properties": {
    "standardVersion": {
      "type": "string"
    },
    "toolVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "strategy",
        "root"
      ],
      "properties": {
        "strategy": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "configDir": {
          "type": [
            "string",
            "null"
          ]
        },
        "config": {
          "type": [
            "string",
            "null"
          ]
        },
        "sdcParser": {
          "type": "string"
        },
        "parser": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "sourceRef",
          "fields",
          "slots",
          "defects"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "machineName": {
            "type": "string"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceRef": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "appliesToken": {
                  "type": "null"
                },
                "canvasFieldType": {
                  "type": "string"
                },
                "cardinality": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "default": {
                  "$ref": "#/$defs/JsonValue"
                },
                "defaultSource": {
                  "type": "string"
                },
                "description": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "kind": {
                  "type": "string"
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "maxItems": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "minItems": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "options": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "$ref": "#/$defs/JsonValue"
                          },
                          "label": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "optionsSource": {
                  "type": "string"
                },
                "provenance": {
                  "type": "object",
                  "properties": {
                    "default": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "options": {
                      "type": "string"
                    },
                    "required": {
                      "type": "string"
                    },
                    "sourceWidget": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "repeatableIn": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "showWhen": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "sourceRef": {
                  "type": "string"
                },
                "sourceType": {
                  "type": "string"
                },
                "sourceWidget": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "targetBundles": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "targetType": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "tokenFamily": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "uid": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "accepts": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "cardinality": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "sourceRef": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "defects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "detail": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "group": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "usage": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "placements": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "structuralRefs": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "pages": {
                "type": "number"
              },
              "unpublishedInstances": {
                "type": "number"
              },
              "inlineBlockEntities": {
                "type": "number"
              },
              "configPlacedBlocks": {
                "type": "number"
              },
              "orphanInstances": {
                "type": "number"
              },
              "examples": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string"
                        },
                        "path": {
                          "type": "string"
                        },
                        "marker": {
                          "type": "string"
                        },
                        "markerKind": {
                          "type": "string"
                        },
                        "markerUniqueToThisComponent": {
                          "type": "boolean"
                        },
                        "instancesOnPage": {
                          "type": "number"
                        },
                        "status": {
                          "type": "number"
                        },
                        "anonymous": {
                          "type": "boolean"
                        },
                        "verifiedAt": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "noExampleReason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tier": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "measuredAt": {
                "type": "string"
              },
              "exampleCandidates": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "templatePlacements": {
                "type": "number"
              },
              "templateBundles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "templateRefs": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "file": {
                          "type": "string"
                        },
                        "line": {
                          "type": "number"
                        },
                        "global": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "string"
                    }
                  ]
                }
              },
              "globalTemplate": {
                "type": "boolean"
              },
              "renderedPages": {
                "type": "number"
              },
              "renderedInstances": {
                "type": "number"
              },
              "renderedExamples": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "structuralReferences": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "tierReason": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "templates": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "status": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "containedBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isCustomComponent": {
            "type": "boolean"
          },
          "sourceSdcId": {
            "type": "string"
          },
          "componentVersion": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "canvasRef": {
            "type": "string"
          },
          "folder": {
            "type": "string"
          },
          "folderRef": {
            "type": "string"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "definition": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "componentVersion": {
                "type": "string"
              },
              "group": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "groupEvidence": {
            "type": "string"
          },
          "isEntryPoint": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "totals": {
      "type": "object",
      "properties": {
        "all": {
          "type": "number"
        },
        "blocks": {
          "type": "number"
        },
        "paragraphs": {
          "type": "number"
        },
        "withDefects": {
          "type": "number"
        },
        "placements": {
          "type": "number"
        },
        "structuralRefs": {
          "type": "number"
        },
        "layout": {
          "type": "number"
        },
        "content": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kind": {
            "type": "string"
          },
          "sourceRef": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "entryPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hostEntityType",
          "hostBundle",
          "field",
          "label",
          "accepts",
          "sourceRef"
        ],
        "properties": {
          "hostEntityType": {
            "type": "string"
          },
          "hostBundle": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "accepts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceRef": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "JsonValue": {
      "description": "External site configuration or third-party JSON values, with explicitly typed recursive values.",
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    }
  }
}

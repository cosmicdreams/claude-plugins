{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/scorecard.schema.json",
  "title": "design-lab run scorecard",
  "description": "Written by scripts/score_run.py. Each section is scored on its own; a section without evidence carries status not-measured and a reason instead of a guess.",
  "type": "object",
  "required": ["scorecardVersion", "generatedAt", "generator", "run", "headline", "sections"],
  "additionalProperties": false,
  "properties": {
    "scorecardVersion": {"const": 1},
    "generatedAt": {"type": "string"},
    "generator": {"type": "string"},
    "run": {
      "type": "object",
      "required": ["directory", "name", "siteLabel"],
      "properties": {
        "directory": {"type": "string"},
        "name": {"type": "string"},
        "siteLabel": {"type": "string"}
      }
    },
    "headline": {
      "type": "object",
      "required": ["coverage", "built", "accuracy", "effort", "highlights"],
      "properties": {
        "coverage": {"type": ["object", "null"]},
        "built": {"type": "object"},
        "accuracy": {"type": "object"},
        "effort": {"type": "object"},
        "highlights": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sections": {
      "type": "object",
      "required": ["identity", "cost", "library", "coverage", "conformance", "accuracy", "repeatability", "schemaChurn", "foundationsVoice", "blindedJudgement"],
      "additionalProperties": false,
      "properties": {
        "identity": {"$comment": "run identity", "type": "object", "required": ["status"], "properties": {"status": {"enum": ["measured", "partial", "not-measured"]}, "fields": {"type": "object"}, "missing": {"type": "array", "items": {"type": "string"}}}, "allOf": [{"if": {"properties": {"status": {"const": "not-measured"}}}, "then": {"required": ["reason"]}}]},
        "cost": {"$comment": "cost and effort", "type": "object", "required": ["status"], "properties": {"status": {"enum": ["measured", "partial", "not-measured"]}, "runner": {"type": "object"}, "timings": {"type": "object"}, "clock": {"type": "object", "required": ["librarySeconds", "benchmarkSeconds", "totalSeconds", "scorerSeconds"], "properties": {"librarySeconds": {"type": ["integer", "null"]}, "benchmarkSeconds": {"type": ["integer", "null"]}, "totalSeconds": {"type": ["integer", "null"]}, "scorerSeconds": {"type": "number"}, "benchmarkStart": {"type": ["string", "null"]}}}, "model": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["measured", "not-measured"]}, "toolCalls": {"type": "integer"}, "tokens": {"type": "object", "additionalProperties": {"type": "integer"}}, "configDirs": {"type": "array", "items": {"type": "string"}}, "production": {"type": "object", "required": ["status"]}, "benchmark": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["measured", "not-measured"]}}}, "byModel": {"type": "array", "items": {"type": "object", "required": ["model", "name", "input", "output", "cacheWrite", "cacheRead", "total", "turns", "toolCalls"], "properties": {"model": {"type": "string"}, "name": {"type": "string"}, "input": {"type": "integer"}, "output": {"type": "integer"}, "cacheWrite": {"type": "integer"}, "cacheRead": {"type": "integer"}, "total": {"type": "integer"}, "turns": {"type": "integer"}, "toolCalls": {"type": "integer"}}}}}}}},
        "library": {"$comment": "library contents", "type": "object", "required": ["status"], "properties": {"status": {"enum": ["measured", "not-measured"]}, "components": {"type": "object"}, "tiers": {"type": "array"}}, "allOf": [{"if": {"properties": {"status": {"const": "not-measured"}}}, "then": {"required": ["reason"]}}]},
        "coverage": {"$comment": "built out of what could have been built, gap by reason, usage-weighted share", "type": "object", "required": ["status"], "properties": {"status": {"enum": ["measured", "not-measured"]}, "found": {"type": "integer"}, "eligible": {"type": "integer"}, "built": {"type": "integer"}, "ratio": {"type": ["number", "null"]}, "gap": {"type": "object", "additionalProperties": {"type": "integer"}}, "excluded": {"type": "object", "additionalProperties": {"type": "integer"}}, "usageWeighted": {"type": "object"}}, "allOf": [{"if": {"properties": {"status": {"const": "not-measured"}}}, "then": {"required": ["reason"]}}]},
        "conformance": {"$comment": "verify-report findings by severity", "type": "object", "required": ["status"], "properties": {"status": {"enum": ["measured", "not-measured"]}, "open": {"type": "object", "additionalProperties": {"type": "integer"}}, "waived": {"type": "integer"}}, "allOf": [{"if": {"properties": {"status": {"const": "not-measured"}}}, "then": {"required": ["reason"]}}]},
        "accuracy": {
          "$comment": "accuracy against the live site: original metric kept beside the corrected one",
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {"enum": ["measured", "partial", "not-measured"]},
            "threshold": {"type": "number"},
            "tolerance": {"type": "number"},
            "overall": {"type": "object"},
            "byBreakpoint": {"type": "object"},
            "pairs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["component", "breakpoint", "original"],
                "properties": {
                  "component": {"type": "string"},
                  "breakpoint": {"type": "string"},
                  "original": {"type": "object", "required": ["ratio", "pass"]},
                  "corrected": {"type": ["object", "null"]},
                  "heightDelta": {"type": ["number", "null"]}
                }
              }
            }
          },
          "allOf": [{"if": {"properties": {"status": {"const": "not-measured"}}}, "then": {"required": ["reason"]}}]
        },
        "repeatability": {"$comment": "compare_runs.py across runs", "type": "object", "required": ["status"], "properties": {"status": {"enum": ["measured", "partial", "not-measured"]}, "level": {"enum": ["build", "pipeline"]}, "comparisons": {"type": "array"}}, "allOf": [{"if": {"properties": {"status": {"const": "not-measured"}}}, "then": {"required": ["reason"]}}]},
        "schemaChurn": {"$comment": "did the run need a schema change or workaround", "type": "object", "required": ["status"], "properties": {"status": {"enum": ["measured", "not-measured"]}, "changed": {"type": "boolean"}, "changes": {"type": "array"}}, "allOf": [{"if": {"properties": {"status": {"const": "not-measured"}}}, "then": {"required": ["reason"]}}]},
        "foundationsVoice": {
          "$comment": "slot for the foundations-and-voice rubric, scored by a person later",
          "type": "object",
          "required": ["status", "rubric", "scores"],
          "properties": {
            "status": {"enum": ["scored-later", "measured"]},
            "rubric": {"type": ["object", "null"]},
            "scores": {"type": "array", "items": {"type": "object", "required": ["criterion", "score"], "properties": {"criterion": {"type": "string"}, "score": {"type": "number"}, "scorer": {"type": "string"}, "note": {"type": "string"}}}},
            "scorers": {"type": "array", "items": {"type": "string"}}
          }
        },
        "blindedJudgement": {
          "$comment": "slot for blinded visual judgement, 1 to 5 per criterion, scored later",
          "type": "object",
          "required": ["status", "criteria", "scores"],
          "properties": {
            "status": {"enum": ["scored-later", "measured"]},
            "scale": {"type": "object"},
            "criteria": {"type": "array", "items": {"type": "object", "required": ["id", "label"]}},
            "scores": {"type": "array", "items": {"type": "object", "required": ["criterion", "score", "scorer"], "properties": {"criterion": {"type": "string"}, "score": {"type": "integer"}, "scorer": {"type": "string"}}}},
            "scorers": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  }
}

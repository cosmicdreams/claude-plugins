{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/build-record.schema.json",
  "title": "design-lab Figma component build record",
  "type": "object",
  "required": [
    "standardVersion",
    "toolVersion",
    "id",
    "figma",
    "documentation",
    "nativeComponent",
    "visualEvidence",
    "assertions",
    "sourceHash"
  ],
  "properties": {
    "standardVersion": {
      "type": "string"
    },
    "toolVersion": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "figma": {
      "type": "object",
      "required": [
        "fileKey",
        "pageId",
        "documentationCardId"
      ],
      "properties": {
        "fileKey": {
          "type": "string"
        },
        "pageId": {
          "type": "string"
        },
        "documentationCardId": {
          "type": "string"
        },
        "componentId": {
          "type": "string"
        },
        "componentSetId": {
          "type": "string"
        },
        "pageName": {
          "type": "string"
        },
        "blockId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "visualEvidence": {
      "type": "object",
      "required": [
        "path",
        "captureFiles",
        "states",
        "breakpoints",
        "comparison"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "captureFiles": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "breakpoints": {
          "type": "object",
          "required": [
            "desktop",
            "tablet",
            "mobile"
          ],
          "properties": {
            "desktop": {
              "$ref": "#/$defs/breakpointEvidence"
            },
            "tablet": {
              "$ref": "#/$defs/breakpointEvidence"
            },
            "mobile": {
              "$ref": "#/$defs/breakpointEvidence"
            }
          },
          "additionalProperties": false
        },
        "comparison": {
          "type": "object",
          "required": [
            "verdict",
            "breakpoints"
          ],
          "properties": {
            "verdict": {
              "enum": [
                "pass",
                "fail",
                "not-run"
              ]
            },
            "reviewedAt": {
              "type": "string"
            },
            "breakpoints": {
              "type": "object",
              "required": [
                "desktop",
                "tablet",
                "mobile"
              ],
              "properties": {
                "desktop": {
                  "enum": [
                    "pass",
                    "fail",
                    "not-run"
                  ]
                },
                "tablet": {
                  "enum": [
                    "pass",
                    "fail",
                    "not-run"
                  ]
                },
                "mobile": {
                  "enum": [
                    "pass",
                    "fail",
                    "not-run"
                  ]
                }
              },
              "additionalProperties": false
            },
            "metrics": {
              "$ref": "https://design-lab.local/schemas/step-result.schema.json"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "documentation": {
      "type": "object",
      "required": [
        "anatomy",
        "breakpointScreenshots"
      ],
      "properties": {
        "anatomy": {
          "type": "object",
          "required": [
            "fields",
            "relationships"
          ],
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/documentationField"
              }
            },
            "relationships": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/documentationRelationship"
              }
            },
            "emptyReason": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "breakpointScreenshots": {
          "type": "object",
          "required": [
            "desktop",
            "tablet",
            "mobile"
          ],
          "properties": {
            "desktop": {
              "type": "string",
              "minLength": 1
            },
            "tablet": {
              "type": "string",
              "minLength": 1
            },
            "mobile": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "nativeComponent": {
      "type": "object",
      "required": [
        "nodeType",
        "rootHasImageFill",
        "componentProperties",
        "nestedInstances",
        "validation"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/detection.schema.json",
  "title": "design-lab strategy detection",
  "type": "object",
  "required": ["root", "componentSources", "tokenSources", "usageSources", "recommended", "priorArt"],
  "properties": {
    "root": {"type": "string"},
    "componentSources": {"type": "array", "items": {"$ref": "#/$defs/strategy"}},
    "tokenSources": {"type": "array", "items": {"$ref": "#/$defs/strategy"}},
    "usageSources": {"type": "array", "items": {"$ref": "#/$defs/strategy"}},
    "recommended": {"type": "object"},
    "priorArt": {"type": "array"}
  },
  "$defs": {
    "strategy": {
      "type": "object",
      "required": ["strategy"],
      "properties": {"strategy": {"type": "string"}},
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

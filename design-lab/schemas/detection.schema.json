{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/detection.schema.json",
  "title": "design-lab strategy detection",
  "type": "object",
  "required": [
    "root",
    "componentSources",
    "tokenSources",
    "usageSources",
    "recommended",
    "priorArt"
  ],
  "properties": {
    "root": {
      "type": "string"
    },
    "componentSources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/strategy"
      }
    },
    "tokenSources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/strategy"
      }
    },
    "usageSources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/strategy"
      }
    },
    "recommended": {
      "type": "object",
      "properties": {
        "component": {
          "type": [
            "string",
            "null"
          ]
        },
        "token": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "priorArt": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "docroot": {
      "type": "string"
    },
    "configSync": {
      "type": [
        "string",
        "null"
      ]
    },
    "configCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "entityCount": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "siteStudio": {
      "type": "object",
      "properties": {
        "configDir": {
          "type": "null"
        },
        "configFrom": {
          "type": "null"
        },
        "problem": {
          "type": "string"
        },
        "declared": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "families": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "components": {
          "type": "number"
        },
        "customStyles": {
          "type": "number"
        },
        "customComponents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "customComponentProblems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "customComponentsFromActiveExtensionsOnly": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "$defs": {
    "strategy": {
      "type": "object",
      "required": [
        "strategy"
      ],
      "properties": {
        "strategy": {
          "type": "string"
        },
        "count": {
          "type": "number"
        },
        "blocks": {
          "type": "number"
        },
        "paragraphs": {
          "type": "number"
        },
        "evidence": {
          "type": "string"
        },
        "withEnumProps": {
          "type": "number"
        },
        "withSlots": {
          "type": "number"
        },
        "filesWithVars": {
          "type": "number"
        },
        "filesLoadedByTheme": {
          "type": "number"
        },
        "variablesLoadedByTheme": {
          "type": "number"
        },
        "files": {
          "type": "number"
        },
        "variables": {
          "type": "number"
        },
        "maps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string"
              },
              "variables": {
                "type": "number"
              },
              "sources": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "configComponents": {
          "type": "number"
        },
        "customComponents": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

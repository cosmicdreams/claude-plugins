{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/capture-evidence.schema.json",
  "title": "design-lab visual capture evidence",
  "type": "object",
  "required": [
    "standardVersion",
    "toolVersion",
    "generatedAt",
    "canonicalBaseUrl",
    "captures",
    "problems"
  ],
  "properties": {
    "standardVersion": {
      "type": "string"
    },
    "toolVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "canonicalBaseUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "captures": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "verificationUrl",
          "linkUrl",
          "selector",
          "states",
          "images"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "verificationUrl": {
            "type": "string"
          },
          "linkUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "selector": {
            "type": "string",
            "minLength": 1
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "images": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string"
                },
                "hash": {
                  "type": "string"
                },
                "height": {
                  "type": "integer"
                },
                "state": {
                  "type": "string"
                },
                "viewport": {
                  "type": "string"
                },
                "width": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "properties": {}
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "componentId": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "componentId": {
            "type": "string"
          },
          "chosen": {
            "type": [
              "string",
              "null"
            ]
          },
          "revealed": {
            "type": "boolean"
          },
          "seconds": {
            "type": "number"
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "matches": {
                  "type": "number"
                },
                "visible": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                },
                "revealed": {
                  "type": "boolean"
                },
                "error": {
                  "type": "string"
                },
                "seconds": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

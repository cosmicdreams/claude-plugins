{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/capture-evidence.schema.json",
  "title": "design-lab visual capture evidence",
  "type": "object",
  "required": ["standardVersion", "toolVersion", "generatedAt", "canonicalBaseUrl", "captures", "problems"],
  "properties": {
    "standardVersion": {"type": "string"},
    "toolVersion": {"type": "string"},
    "generatedAt": {"type": "string"},
    "canonicalBaseUrl": {"type": "string", "pattern": "^https://"},
    "captures": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path", "verificationUrl", "linkUrl", "selector", "states", "images"],
        "properties": {
          "path": {"type": "string", "pattern": "^/"},
          "verificationUrl": {"type": "string"},
          "linkUrl": {"type": "string", "pattern": "^https://"},
          "selector": {"type": "string", "minLength": 1},
          "states": {"type": "array", "minItems": 1},
          "images": {"type": "array", "minItems": 1}
        },
        "additionalProperties": true
      }
    },
    "problems": {"type": "array"}
  },
  "additionalProperties": true
}

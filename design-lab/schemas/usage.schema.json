{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/usage.schema.json",
  "title": "design-lab component usage evidence",
  "type": "object",
  "required": [
    "standardVersion",
    "toolVersion",
    "generatedAt",
    "source",
    "usage",
    "problems"
  ],
  "properties": {
    "standardVersion": {
      "type": "string"
    },
    "toolVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "strategy",
        "scope",
        "definitions"
      ],
      "properties": {
        "strategy": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "definitions": {
          "type": "object",
          "properties": {
            "placements": {
              "type": "string"
            },
            "structuralRefs": {
              "type": "string"
            },
            "templatePlacements": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "ddevProject": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "approot": {
          "type": "string"
        },
        "population": {
          "type": "object",
          "properties": {
            "siteStudioLayouts": {
              "type": "number"
            },
            "paragraphInstances": {
              "type": "number"
            },
            "blockContentEntities": {
              "type": "number"
            },
            "nodes": {
              "type": "number"
            },
            "layoutBuilderSections": {
              "type": "number"
            },
            "publishedPages": {
              "type": "number"
            },
            "pagePlacementRows": {
              "type": "number"
            },
            "templateNodes": {
              "type": "number"
            },
            "siteStudioTemplates": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "exampleVerification": {
          "type": "object",
          "properties": {
            "baseUrl": {
              "type": "string"
            },
            "pagesFetched": {
              "type": "number"
            },
            "anonymous": {
              "type": "boolean"
            },
            "twigDebug": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "renderedVerification": {
          "type": "object",
          "properties": {
            "baseUrl": {
              "type": "string"
            },
            "pathsSelected": {
              "type": "number"
            },
            "pagesFetched": {
              "type": "number"
            },
            "pathsFailed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "root": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "placements",
          "structuralRefs",
          "pages"
        ],
        "properties": {
          "placements": {
            "type": "integer",
            "minimum": 0
          },
          "structuralRefs": {
            "type": "integer",
            "minimum": 0
          },
          "pages": {
            "type": "integer",
            "minimum": 0
          },
          "unpublishedInstances": {
            "type": "number"
          },
          "inlineBlockEntities": {
            "type": "number"
          },
          "configPlacedBlocks": {
            "type": "number"
          },
          "orphanInstances": {
            "type": "number"
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "marker": {
                  "type": "string"
                },
                "markerKind": {
                  "type": "string"
                },
                "markerUniqueToThisComponent": {
                  "type": "boolean"
                },
                "instancesOnPage": {
                  "type": "number"
                },
                "status": {
                  "type": "number"
                },
                "anonymous": {
                  "type": "boolean"
                },
                "verifiedAt": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "noExampleReason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "exampleCandidates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "templatePlacements": {
            "type": "number"
          },
          "templateBundles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "templateRefs": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "line": {
                      "type": "number"
                    },
                    "global": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "string"
                }
              ]
            }
          },
          "globalTemplate": {
            "type": "boolean"
          },
          "renderedPages": {
            "type": "number"
          },
          "renderedInstances": {
            "type": "number"
          },
          "renderedExamples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "templates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "properties": {}
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

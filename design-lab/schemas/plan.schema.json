{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/plan.schema.json",
  "title": "design-lab build plan",
  "type": "object",
  "required": [
    "standardVersion",
    "plans"
  ],
  "properties": {
    "standardVersion": {
      "type": "string"
    },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "libraryRole",
          "visualIdentity",
          "visualEvidence",
          "variantAxes",
          "variants",
          "properties",
          "verdict"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "variantAxes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "options": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            }
          },
          "variants": {
            "type": "integer",
            "minimum": 1
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "treatment": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "libraryRole": {
            "enum": [
              "component",
              "subcomponent",
              "schema-only",
              "retirement"
            ]
          },
          "visualIdentity": {
            "enum": [
              "independent",
              "embedded",
              "unverified",
              "none"
            ]
          },
          "visualEvidence": {
            "type": "object",
            "required": [
              "captured",
              "renderSignals",
              "path",
              "states",
              "images"
            ],
            "properties": {
              "captured": {
                "type": "boolean"
              },
              "renderSignals": {
                "type": "boolean"
              },
              "path": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "states": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "images": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "hash": {
                      "type": "string"
                    },
                    "height": {
                      "type": "integer"
                    },
                    "state": {
                      "type": "string"
                    },
                    "viewport": {
                      "type": "string"
                    },
                    "width": {
                      "type": "integer"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "verdict": {
            "enum": [
              "build",
              "map",
              "document",
              "refuse"
            ]
          },
          "label": {
            "type": "string"
          },
          "naiveVariants": {
            "type": "number"
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "skippedFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "refuseReason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "defects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "generatedAt": {
      "type": "string"
    },
    "maxVariants": {
      "type": "number"
    }
  },
  "additionalProperties": false
}

{
    "description": "Sprint plugin hooks: session start and pre-compact advisory.",
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh",
                        "timeout": 30
                    }
                ]
            }
        ],
        "PreCompact": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact.sh",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}

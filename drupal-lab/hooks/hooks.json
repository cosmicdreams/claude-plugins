{
    "description": "drupal-lab hooks: branch guard for Drupal team workflow.",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/branch-guard.sh",
                        "timeout": 5
                    }
                ]
            }
        ]
    }
}

{
    "description": "Detects scaffold triggers at session start.",
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scaffold-detect.sh",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}

{
    "description": "Drover plugin hooks: ambient error status injection on session start.",
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start.sh",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}

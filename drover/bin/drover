#!/usr/bin/env bash
# drover — on/off control for the entire drover plugin.
#
#   drover stop       Kill every drover process — dashboard, umbrella,
#                     all watchers. Leave state files in place.
#   drover start      Launch the dashboard (which arms the umbrella,
#                     which spawns watchers per drover-config.json).
#   drover restart    stop + start with a ~2s settle window.
#   drover status     List what's running + what's stale.
#
# Intent: provide a single clean way to recover from process zoos,
# broken-pipe cascades, and stale pidfile drift. Tonight's run showed
# 45 umbrellas + 10 orphan watchers could accumulate from repeated
# dashboard restarts; this script nukes them all deterministically.
#
# Not run inside a Claude Code session — the plugin cache reinstall
# workflow is separate (see admin/skills/bump-version/).

set -uo pipefail

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PORT="${DROVER_PORT:-3749}"
STATE_BASE="${CLAUDE_PLUGIN_DATA:-$HOME/.claude/plugins/data/drover-fallback}"
INGEST_STATE_DIR="$STATE_BASE/dashboard-ingest-state"
UMBRELLA_PID_FILE="$INGEST_STATE_DIR/umbrella.pid"
TRACK_DIR="$INGEST_STATE_DIR/umbrella-track"

# --- helpers -------------------------------------------------------------

# macOS pgrep -f can't handle literal slashes in the pattern — using
# bare script names keeps matches reliable. Each name is unique enough
# in a process listing that collisions aren't a real concern.
pgrep_drover() {
  pgrep -f 'umbrella-watch.sh' 2>/dev/null
  pgrep -f 'acquia-watch.py' 2>/dev/null
  pgrep -f 'ddev-watch.py' 2>/dev/null
  pgrep -f 'wp-watch.py' 2>/dev/null
  pgrep -f 'bd-ready-watch.py' 2>/dev/null
  pgrep -f 'drover.*dashboard.*server.js' 2>/dev/null
}

count_drover() { pgrep_drover | sort -u | wc -l | tr -d ' '; }

count_by() { pgrep -f "$1" 2>/dev/null | wc -l | tr -d ' '; }

# Count only top-level umbrella instances (parent isn't itself an
# umbrella). umbrella-watch.sh forks subshells during normal operation
# — each one shows up in pgrep -f but only the root process per
# umbrella tree actually matters.
count_umbrella_roots() {
  local roots=0
  for p in $(pgrep -f 'umbrella-watch.sh' 2>/dev/null); do
    local ppid
    ppid="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')"
    if [ -z "$ppid" ]; then continue; fi
    if ! ps -o command= -p "$ppid" 2>/dev/null | grep -q 'umbrella-watch.sh'; then
      roots=$((roots + 1))
    fi
  done
  echo "$roots"
}

kill_tree() {
  # SIGTERM first, then SIGKILL for holdouts after a short settle.
  local patterns=(
    'drover.*dashboard.*server.js'
    'umbrella-watch.sh'
    'acquia-watch.py'
    'ddev-watch.py'
    'wp-watch.py'
    'bd-ready-watch.py'
  )
  for p in "${patterns[@]}"; do
    pkill -TERM -f "$p" 2>/dev/null || true
  done
  sleep 1
  for p in "${patterns[@]}"; do
    pkill -KILL -f "$p" 2>/dev/null || true
  done
}

clean_pids() {
  rm -f "$UMBRELLA_PID_FILE" 2>/dev/null
  find "$TRACK_DIR" -maxdepth 1 -name '*.pid' -delete 2>/dev/null
}

# --- commands ------------------------------------------------------------

cmd_stop() {
  local before after
  before="$(count_drover)"
  echo "drover stop: $before process(es) running"
  kill_tree
  clean_pids
  after="$(count_drover)"
  if [ "$after" -gt 0 ]; then
    echo "WARNING: $after process(es) still alive after SIGKILL — inspect manually with: pgrep -af drover"
    exit 1
  fi
  echo "drover stop: clean. Side-files retained in $TRACK_DIR/sources/"
}

cmd_start() {
  # Only reject on a real LISTEN; a recently-killed dashboard leaves
  # TIME_WAIT entries + client-side Chrome connections that lsof -ti
  # without -sTCP:LISTEN would incorrectly flag as "in use".
  if lsof -ti:"$PORT" -sTCP:LISTEN > /dev/null 2>&1; then
    echo "drover start: port $PORT already has a LISTEN process. Run 'drover restart' to replace it."
    return 2
  fi
  local server_js="$PLUGIN_ROOT/tools/dashboard/server.js"
  if [ ! -f "$server_js" ]; then
    echo "drover start: server.js not found at $server_js" >&2
    return 2
  fi
  local log_file="${DROVER_DASH_LOG:-/tmp/drover-dash.log}"
  PORT="$PORT" nohup node "$server_js" --all-projects > "$log_file" 2>&1 &
  local pid=$!
  disown 2>/dev/null || true
  echo "$pid" > /tmp/drover-dash.pid
  # Wait up to 10s for the port to open.
  local i=0
  while [ $i -lt 20 ]; do
    if lsof -ti:"$PORT" > /dev/null 2>&1; then
      echo "drover start: dashboard up on http://localhost:$PORT (pid=$pid, log=$log_file)"
      return 0
    fi
    sleep 0.5
    i=$((i + 1))
  done
  echo "drover start: port $PORT did not open within 10s — check $log_file" >&2
  return 1
}

cmd_restart() {
  cmd_stop
  sleep 2
  cmd_start
}

cmd_status() {
  # lsof -i:PORT returns every process with ANY socket on the port —
  # including client-side connections (browser tabs). We want the
  # LISTEN-side process only.
  local dash_port="—"
  local listener
  listener="$(lsof -ti:"$PORT" -sTCP:LISTEN 2>/dev/null | head -1)"
  if [ -n "$listener" ]; then dash_port="$listener"; fi
  echo "dashboard (:$PORT):              pid=$dash_port"
  echo "umbrella (root):                $(count_umbrella_roots) process(es)"
  echo "acquia-watch.py:                $(count_by 'drover/scripts/monitors/acquia-watch.py') process(es)"
  echo "ddev-watch.py:                  $(count_by 'drover/scripts/monitors/ddev-watch.py') process(es)"
  echo "wp-watch.py:                    $(count_by 'drover/scripts/monitors/wp-watch.py') process(es)"
  echo "bd-ready-watch.py:              $(count_by 'drover/scripts/monitors/bd-ready-watch.py') process(es)"
  echo ""
  local stale=0
  if [ -d "$TRACK_DIR" ]; then
    for pf in "$TRACK_DIR"/*.pid; do
      [ -f "$pf" ] || continue
      local recorded_pid
      recorded_pid="$(awk 'NR==2 { print; exit }' "$pf" 2>/dev/null | tr -d ' ')"
      if [ -n "$recorded_pid" ] && ! kill -0 "$recorded_pid" 2>/dev/null; then
        stale=$((stale + 1))
      fi
    done
  fi
  if [ "$stale" -gt 0 ]; then
    echo "stale pidfiles: $stale (run 'drover restart' to clean)"
  else
    echo "stale pidfiles: 0"
  fi
}

# --- entry ---------------------------------------------------------------

case "${1:-}" in
  stop)    cmd_stop ;;
  start)   cmd_start ;;
  restart) cmd_restart ;;
  status)  cmd_status ;;
  *)
    echo "usage: drover {stop|start|restart|status}"
    echo ""
    echo "  stop     Kill every drover process (dashboard + umbrella + watchers)"
    echo "           and clear stale pidfiles. Side-files preserved."
    echo "  start    Launch the dashboard (arms the umbrella automatically)."
    echo "  restart  stop + settle + start."
    echo "  status   Report what's running vs. what's stale."
    exit 2
    ;;
esac

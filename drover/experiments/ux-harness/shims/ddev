#!/usr/bin/env bash
# Shim replacing the real `ddev` CLI during harness runs.
# Replays lines from a fixture file, honoring the subcommand:
#   ddev --project X drush watchdog:tail   → cat $DROVER_HARNESS_WATCHDOG_FIXTURE
#   ddev --project X logs -f --service web → cat $DROVER_HARNESS_WEBLOG_FIXTURE
#   ddev list -A --json-output             → minimal healthy JSON
# Any other invocation → silent success.
set -u

args=("$@")
joined="${args[*]}"

fixture=""
case "$joined" in
  *drush\ watchdog:tail*) fixture="${DROVER_HARNESS_WATCHDOG_FIXTURE:-/dev/null}" ;;
  *logs*--service\ web*) fixture="${DROVER_HARNESS_WEBLOG_FIXTURE:-/dev/null}" ;;
  *list*--json-output*)
    cat <<'JSON'
{"raw":[{"name":"harness-proj","status":"running","approot":"/tmp/harness"}]}
JSON
    exit 0
    ;;
  *) exit 0 ;;
esac

# Replay: cat the fixture then stay alive so ddev-watch sees a live pipe.
# `ddev-watch.py` tails `for line in proc.stdout`, which exits on EOF. We
# want bounded behaviour, so: cat then sleep.
if [ -s "$fixture" ]; then
  cat "$fixture"
fi
# Stay alive until parent kills us. Unbuffered so the reader gets lines.
sleep "${DROVER_HARNESS_SHIM_LINGER:-2}"

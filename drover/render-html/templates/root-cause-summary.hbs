<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{meta.project}} — {{meta.month_label}} root-cause summary</title>
  {{> head-theme-init}}
  <style>
    {{{css}}}
    
    .headline-card {
      background: var(--color-primary);
      color: var(--color-surface);
      border-radius: var(--rounded-lg);
      padding: var(--space-xl);
      margin-bottom: var(--space-xl);
      box-shadow: 0 4px 12px rgba(0, 27, 103, 0.08);
    }
    .headline-card__title {
      font-family: var(--font-display-family);
      font-size: 1.75rem;
      font-weight: 600;
      line-height: 1.25;
      margin: 0 0 var(--space-md) 0;
      color: var(--color-accent-mark-green);
    }
    .headline-card__desc {
      font-size: var(--font-body-lg-size);
      line-height: 1.6;
      opacity: 0.9;
      margin: 0;
    }
    
    .trend-badge {
      display: inline-block;
      font-family: var(--font-label-family);
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: var(--font-label-tracking);
      text-transform: uppercase;
      border-radius: var(--rounded-sm);
      padding: 2px var(--space-xs);
      vertical-align: middle;
      margin-left: var(--space-sm);
    }
    .trend-badge--up   { background: #FBE2EA; color: var(--color-trend-up); }
    .trend-badge--down { background: var(--color-tint-mint); color: var(--color-trend-down); }
    .trend-badge--flat { background: var(--color-surface-alt); color: var(--color-trend-flat); }
    .trend-badge--new  { background: var(--color-tint-blue); color: var(--color-trend-new); }
    
    .cause-box {
      background: var(--color-surface-alt);
      border-radius: var(--rounded-md);
      padding: var(--space-md);
      margin: var(--space-md) 0;
      border-left: 4px solid var(--color-secondary);
    }
    .cause-box__header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--space-md);
      border-bottom: 1px solid var(--color-border);
      padding-bottom: var(--space-xs);
    }
    .cause-box__title {
      font-family: var(--font-h3-family);
      font-size: var(--font-h3-size);
      font-weight: 600;
      color: var(--color-text-strong);
      margin: 0;
    }
    .cause-box__confidence {
      font-family: var(--font-label-family);
      font-size: var(--font-label-size);
      font-weight: 500;
      letter-spacing: var(--font-label-tracking);
      text-transform: uppercase;
      color: var(--color-text-muted);
    }
    .cause-box__field {
      margin-bottom: var(--space-sm);
    }
    .cause-box__label {
      font-family: var(--font-label-family);
      font-size: var(--font-label-size);
      font-weight: 600;
      letter-spacing: var(--font-label-tracking);
      text-transform: uppercase;
      color: var(--color-text-muted);
      margin: 0 0 2px 0;
    }
    .cause-box__value {
      margin: 0;
      font-size: var(--font-body-sm-size);
      color: var(--color-text);
      line-height: 1.5;
    }
    
    .meta-list {
      list-style: none;
      padding: 0;
      margin: 0 0 var(--space-md) 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: var(--space-sm);
      font-size: var(--font-body-sm-size);
    }
    .meta-list li {
      padding: var(--space-xs) 0;
      border-bottom: 1px solid var(--color-border);
      color: var(--color-text-soft);
    }
    .meta-list strong {
      color: var(--color-text-strong);
    }
  </style>
</head>
<body>
<div class="page">

  <header class="page-header">
    <div class="page-header__brand">
      {{#if logoDataUri}}<img src="{{logoDataUri}}" alt="Velir" class="page-header__logo">{{/if}}
      <div class="page-header__title">{{meta.project}} application errors</div>
    </div>
    <div class="page-header__actions">
      <span class="page-header__meta">{{meta.month_label}} · {{meta.env}}</span>
      {{> theme-toggle-button}}
    </div>
  </header>

  <main class="page-body">

    <h1 class="display">Root-Cause Summary</h1>
    <p class="subtitle">Concentration lens: focusing resolution efforts on the top issues driving the bulk of noise for {{meta.project}} in {{meta.month_label}}.</p>

    {{#if coverageLow}}
    <div class="coverage-banner">
      <span class="coverage-banner__icon">⚠</span>
      <span><strong>Coverage:</strong> {{coverage.coverage_pct}}% — {{coverage.present_days}} of {{coverage.expected_days}} expected (env × type × day) entries were retrievable. Totals below understate the true volume.</span>
    </div>
    {{/if}}

    <div class="headline-card">
      <h2 class="headline-card__title">The top {{topN}} issues account for {{topSharePct}}% of all {{fmt totals.events_total}} events.</h2>
      <p class="headline-card__desc">Pareto cut: <strong>{{paretoN}}</strong> fingerprints make up <strong>{{paretoPct}}%</strong> of total volume. The rest of this report focuses on those — fix them first to silence most of the noise.</p>
    </div>

    <h2 class="section">Top issues by share of volume</h2>
    <div class="chart-container">
      {{#each volumeChart}}
      <div class="chart interactive-chart-row" data-index="{{@index}}" data-label="{{label}}" data-count="{{fmt count}}" data-share="{{sharePct}}" style="cursor: pointer;">
        <div class="chart__label" title="{{label}}">
          <code>{{label}}</code>
        </div>
        <svg class="chart__svg" preserveAspectRatio="none">
          <rect class="chart__svg-track" width="100%" height="100%" rx="4"></rect>
          <rect class="chart__svg-fill{{#if first}} chart__svg-fill--accent{{/if}}" style="width: {{widthPct}}%" height="100%" rx="4"></rect>
        </svg>
        <div class="chart__value">{{fmt count}} <span style="opacity:.7">({{sharePct}}%)</span></div>
      </div>
      {{/each}}
    </div>

    <h2 class="section">What each top issue is</h2>
    {{#each topIssues}}
    <div class="ticket-card" id="issue-card-{{@index}}">
      <p class="ticket-card__title">{{index}}. {{title}}</p>
      
      <p class="ticket-card__meta">
        <span class="severity-pill severity-pill--{{severity}}">{{severity}}</span>
        {{#if trend}}<span class="trend-badge trend-badge--{{trendKey}}">{{trend}}</span>{{/if}}
        &nbsp;·&nbsp; {{fmt count}} events ({{sharePct}}% of total)
      </p>

      <ul class="meta-list">
        <li><strong>First seen:</strong> {{#if firstSeen}}{{firstSeen}}{{else}}?{{/if}}</li>
        <li><strong>Last seen:</strong> {{#if lastSeen}}{{lastSeen}}{{else}}?{{/if}}</li>
        {{#if (eq memberCount 1)}}
        <li><strong>Fingerprint:</strong> <code>{{fingerprint}}</code></li>
        {{else}}
        <li><strong>Fingerprints:</strong> {{memberCount}} combined</li>
        {{/if}}
      </ul>

      {{#if cause}}
      <div class="cause-box">
        <div class="cause-box__header">
          <h4 class="cause-box__title">{{cause.title}}</h4>
          <span class="cause-box__confidence">Confidence: {{cause.confidence}}</span>
        </div>
        
        <div class="cause-box__field">
          <p class="cause-box__label">Likely Cause</p>
          <p class="cause-box__value">{{cause.explanation}}</p>
        </div>

        <div class="cause-box__field">
          <p class="cause-box__label">Suggested Fix</p>
          <p class="cause-box__value">{{cause.suggested_fix}}</p>
        </div>
      </div>
      {{/if}}

      {{#if sample}}
      <p class="cause-box__label" style="margin-left: 4px;">Representative message</p>
      <pre class="ticket-card__sample">{{sample}}</pre>
      {{/if}}
    </div>
    {{/each}}

    {{#if retrievalGaps.length}}
    <h2 class="section">Days with retrieval gaps</h2>
    <ul class="meta-list" style="display: block;">
      {{#each retrievalGaps}}
      <li style="border: none; padding: 2px 0;">⚠️ <strong>{{this}}</strong></li>
      {{/each}}
      {{#if hasMoreGaps}}
      <li style="border: none; padding: 2px 0; color: var(--color-text-muted);">...and {{missingGapsCount}} more.</li>
      {{/if}}
    </ul>
    {{/if}}

    {{#if tickets.length}}
    <h2 class="section">Recommended JIRA tickets</h2>
    {{#each tickets}}
    <div class="ticket-card">
      <p class="ticket-card__title">{{title}}</p>
      <p class="ticket-card__meta">
        Priority: {{priority}}
        {{#if labels.length}}&nbsp;·&nbsp; Labels: {{join labels ", "}}{{/if}}
        &nbsp;·&nbsp; {{fmt count}} events
      </p>
      <p class="ticket-card__desc">{{description}}</p>
      {{#if sample}}<pre class="ticket-card__sample">{{sample}}</pre>{{/if}}
    </div>
    {{/each}}
    {{/if}}

    {{#if supplementaryGroups.length}}
    {{> supplementary-detail groups=supplementaryGroups}}
    {{/if}}

  </main>

  <footer class="footer">
    <span>Prepared by Velir</span>
    <span>Generated {{generatedAt}}</span>
  </footer>
</div>
{{> theme-toggle-script}}
<script>
  (function() {
    // Chart tooltips + click-to-scroll
    const charts = document.querySelectorAll(".interactive-chart-row");
    const tooltip = document.createElement("div");
    tooltip.className = "chart-tooltip";
    document.body.appendChild(tooltip);

    charts.forEach(chart => {
      chart.addEventListener("mousemove", function(e) {
        const label = chart.getAttribute("data-label");
        const count = chart.getAttribute("data-count");
        const share = chart.getAttribute("data-share");
        
        tooltip.innerHTML = `<strong>${label}</strong><br/>Volume: <strong>${count} events</strong> (${share}%)<br/><span style="font-size:11px;opacity:0.8;">Click to scroll to details</span>`;
        tooltip.classList.add("visible");
        
        tooltip.style.left = (e.pageX + 15) + "px";
        tooltip.style.top = (e.pageY - 20) + "px";
      });

      chart.addEventListener("mouseleave", function() {
        tooltip.classList.remove("visible");
      });

      chart.addEventListener("click", function() {
        const index = chart.getAttribute("data-index");
        const target = document.getElementById("issue-card-" + index);
        if (target) {
          target.scrollIntoView({ behavior: "smooth", block: "center" });
          
          target.classList.remove("highlighted");
          void target.offsetWidth; // trigger reflow
          target.classList.add("highlighted");
        }
      });
    });
  })();
</script>
</body>
</html>

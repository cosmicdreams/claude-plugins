<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{meta.project}} — {{meta.month_label}} error report</title>
  <style>{{{css}}}</style>
  {{> head-theme-init}}
</head>
<body>
<div class="page">

  {{> report-header
      title=(concat meta.project " application errors")
      meta=(concat meta.month_label " · " meta.env)}}

  <main class="page-body">

    <h1 class="display">{{meta.month_label}} error report</h1>
    <p class="subtitle">A summary of application-error volume and the issues that contributed most for {{meta.project}} in {{meta.month_label}}.</p>

    {{> coverage-banner
        coverageLow=coverageLow
        coverage=coverage
        message="Totals below understate the true volume."}}

    <div class="metric-row">
      {{> metric-card label="Total events" value=(fmt totals.events_total)}}
      {{> metric-card label="Unique issues" value=totals.groups_total}}
      {{> metric-card
          label="Top issue share"
          value=(pct topShare)
          hint="of all events caused by the single largest fingerprint"}}
    </div>

    {{#if incidentBrief}}
    {{> incident-brief incidentBrief}}
    {{/if}}

    {{#if dailySeries}}
    <h2 class="section">Volume across the month</h2>
    <p>Daily event volume for every day with retrievable logs. Look for the
    shape — a flat line and a single spike mean very different things, and the
    monthly total alone hides both.</p>
    {{> chart-line line=(lineChart dailySeries) title="Daily event volume"}}
    {{#if undatedEvents}}
    <p style="color: var(--color-text-muted); font-size: var(--font-body-sm-size);">
    A further {{undatedEvents}} events carried no parseable timestamp and are
    counted in the totals above but cannot be placed on this timeline.</p>
    {{/if}}
    {{/if}}

    {{#if channelSegments}}
    <h2 class="section">Where the events come from</h2>
    <p>Share of all events by Drupal channel. Segments are labelled with their
    counts and shares, so the split is readable without relying on colour.</p>
    {{> chart-donut
        segments=(donutSegments channelSegments minShare=1)
        centerValue=eventsTotalLabel
        centerLabel="events"
        title="Events by channel"}}
    {{/if}}

    <h2 class="section">Severity breakdown</h2>
    <div>
      {{#each severityChart}}
      {{> chart-bar
          label=key
          severity=key
          value=(fmt count)
          share=sharePct
          width=widthPct
          accent=first}}
      {{/each}}
    </div>

    <h2 class="section">Top issues this month</h2>
    {{#each topIssues}}
    <div class="ticket-card">
      <p class="ticket-card__title">{{title}}</p>
      <p class="ticket-card__meta">
        <span class="severity-pill severity-pill--{{severity}}">{{severity}}</span>
        &nbsp;·&nbsp; {{fmt count}} events
        &nbsp;·&nbsp; {{channel}}
        {{#if firstSeen}}&nbsp;·&nbsp; first seen {{firstSeen}}{{/if}}
        {{#if lastSeen}}&nbsp;·&nbsp; last seen {{lastSeen}}{{/if}}
      </p>
      {{#if sample}}<pre class="ticket-card__sample">{{sample}}</pre>{{/if}}
    </div>
    {{/each}}

    {{#if tickets.length}}
    <h2 class="section">Recommended JIRA tickets</h2>
    {{#each tickets}}
    <div class="ticket-card">
      <p class="ticket-card__title">{{title}}</p>
      <p class="ticket-card__meta">
        Priority: {{priority}}
        {{#if labels.length}}&nbsp;·&nbsp; Labels: {{join labels ", "}}{{/if}}
        &nbsp;·&nbsp; {{fmt count}} events
      </p>
      <p class="ticket-card__desc">{{description}}</p>
      {{#if sample}}<pre class="ticket-card__sample">{{sample}}</pre>{{/if}}
    </div>
    {{/each}}
    {{/if}}

    {{#if supplementaryGroups.length}}
    {{> supplementary-detail groups=supplementaryGroups}}
    {{/if}}

  </main>

  {{> report-footer
      preparedBy="Prepared by Velir"
      generatedAt=generatedAt}}
</div>
{{> theme-toggle-script}}
</body>
</html>
